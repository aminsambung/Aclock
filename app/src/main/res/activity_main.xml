<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CLOCK FACE"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih desain lalu tambahkan widget ke Home Screen."
        android:textColor="#B8BDC8"
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <ImageView
        android:id="@+id/preview"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Clock preview"
        android:scaleType="fitCenter" />

    <Spinner
        android:id="@+id/faceSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <Switch
        android:id="@+id/secondsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tampilkan jarum detik"
        android:textColor="@color/white"
        android:checked="false"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/applyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SIMPAN & UPDATE WIDGET"
        android:layout_marginTop="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Setelah disimpan: tekan lama Home Screen → Widgets → Clock Face Widget."
        android:textColor="#8F95A3"
        android:textSize="13sp"
        android:layout_marginTop="18dp" />

</LinearLayout>
